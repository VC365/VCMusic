{
  "app-id": "ir.NonFree.VCMusic",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "VCMusic",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--env=LADSPA_PATH=/app/lib/ladspa"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "ladspa-sdk",
      "no-autogen": true,
      "subdir": "src",
      "make-install-args": [
        "INSTALL_PLUGINS_DIR=/app/lib/ladspa",
        "INSTALL_INCLUDE_DIR=/app/include",
        "INSTALL_BINARY_DIR=/app/bin"
      ],
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://deb.debian.org/debian/pool/main/l/ladspa-sdk/ladspa-sdk_1.17.orig.tar.gz",
          "sha256": "d9d596171d93f9c226fcdb7e27c6f917422ac487efe2c05e0a18094df4268061"
        }
      ]
    },
    {
      "name": "rubberband",
      "buildsystem": "meson",
      "config-opts": [
        "-Dladspa=enabled",
        "-Dlv2=disabled",
        "-Dvamp=disabled",
        "-Dcmdline=disabled",
        "-Djni=disabled",
        "-Dtests=disabled",
        "-Dfft=builtin",
        "-Dresampler=builtin",
        "-Ddefault_library=shared"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/share/man"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://breakfastquay.com/files/releases/rubberband-4.0.0.tar.bz2",
          "sha256": "af050313ee63bc18b35b2e064e5dce05b276aaf6d1aa2b8a82ced1fe2f8028e9"
        }
      ]
    },
    {
      "name": "rubberband",
      "buildsystem": "meson",
      "config-opts": [
        "-Dauto_features=disabled",
        "-Dladspa=enabled",
        "-Dlv2=disabled",
        "-Dvamp=disabled",
        "-Dcmdline=disabled",
        "-Djni=disabled",
        "-Dtests=disabled",
        "-Dfft=builtin",
        "-Dresampler=builtin",
        "-Ddefault_library=shared"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/share/man"
      ],
      "post-install": [
        "install -Dm644 COPYING /app/share/licenses/$FLATPAK_ID/rubberband/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://breakfastquay.com/files/releases/rubberband-4.0.0.tar.bz2",
          "sha256": "af050313ee63bc18b35b2e064e5dce05b276aaf6d1aa2b8a82ced1fe2f8028e9"
        }
      ]
    }
    {
      "name": "VCMusic",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/run/build/VCMusic/crystal/bin/"
      },
      "build-commands": [
        "VCMUSIC_LOCALE_LOCATION=\\\"/app/share/locale\\\" crystal build ./src/main.cr --release",
        "msgfmt --xml --template data/ir.NonFree.VCMusic.metainfo.xml.in -d \"./po\" -o data/ir.NonFree.VCMusic.metainfo.xml",
        "msgfmt --desktop --template data/ir.NonFree.VCMusic.desktop.in -d \"./po\" -o data/ir.NonFree.VCMusic.desktop",
        "mkdir -p po/mo && for lang in `cat \"po/LINGUAS\"`; do if [[ \"$lang\" == 'en' || \"$lang\" == '' ]]; then continue; fi; mkdir -p \"/app/share/locale/$lang/LC_MESSAGES\"; msgfmt \"po/$lang.po\" -o \"po/mo/$lang.mo\";  install -D -m 0644 \"po/mo/$lang.mo\" \"/app/share/locale/$lang/LC_MESSAGES/ir.NonFree.VCMusic.mo\"; done"
      ],
      "post-install": [
        "install -D -m 0755 VCMusic /app/bin/VCMusic",
        "install -D -m 0644 data/ir.NonFree.VCMusic.desktop /app/share/applications/ir.NonFree.VCMusic.desktop",
        "install -D -m 0644 data/icons/hicolor/scalable/apps/ir.NonFree.VCMusic.svg /app/share/icons/hicolor/scalable/apps/ir.NonFree.VCMusic.svg",
        "install -D -m 0644 data/icons/hicolor/symbolic/ir.NonFree.VCMusic-symbolic.svg /app/share/icons/hicolor/symbolic/apps/ir.NonFree.VCMusic-symbolic.svg",
        "install -D -m 0644 data/ir.NonFree.VCMusic.metainfo.xml /app/share/metainfo/ir.NonFree.VCMusic.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".rucksack",
            ".rucksack.toc",
            "lib/",
            "VCMusic",
            "bin/",
            "data/ir.NonFree.VCMusic.desktop",
            "po/mo/"
          ]
        },
        {
          "type": "archive",
          "dest": "crystal/",
          "url": "https://github.com/crystal-lang/crystal/releases/download/1.21.0/crystal-1.21.0-1-linux-x86_64.tar.gz",
          "sha256": "744561ee3cee1b06d106cf9ae99b8064b4e017518ac414d6dd23cfafe36560c9",
          "only_arches": [
            "x86_64"
          ]
        },
        {
          "type": "archive",
          "dest": "crystal/",
          "url": "https://github.com/crystal-lang/crystal/releases/download/1.21.0/crystal-1.21.0-1-linux-aarch64.tar.gz",
          "sha256": "4f30da9ff083dc485652e3d9b04d7e82cc4c49fb6e8ab3bac76cbde24d960778",
          "only_arches": [
            "aarch64"
          ]
        }
      ]
    },
    {
      "name": "hack_for_Builder",
      "buildsystem": "simple",
      "build-commands": []
    }
  ]
}
